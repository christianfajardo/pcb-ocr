# ── Docker Compose ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=pcb-ocr

# ── OCR Settings ──────────────────────────────────────────────────
OCR_DPI=300
HTTP_TIMEOUT=300

# ── vLLM Settings ─────────────────────────────────────────────────
GLM_OCR_VLLM_URL=http://vllm-glm-ocr:8010/v1
GLM_OCR_MODEL=zai-org/GLM-OCR
QWEN_VL_VLLM_URL=http://vllm-qwen-vl:8011/v1
QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ── Service Endpoints ─────────────────────────────────────────────
TESSERACT_URL=http://tesseract-ocr:8001/extract
GLM_OCR_URL=http://glm-ocr-api:8002/extract
QWEN_VL_URL=http://qwen-vl-api:8003/extract

# ── Reconciliation ────────────────────────────────────────────────
RECONCILIATION_VLLM_URL=http://host.docker.internal:8000/v1
RECONCILIATION_MODEL=nvidia/Qwen3.6-27B-NVFP4

# ── HuggingFace Token (for model downloads) ───────────────────────
# HF_TOKEN=your_token_here

# ── Upload directory ──────────────────────────────────────────────
UPLOAD_DIR=/data/uploads