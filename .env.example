# ── Docker Compose ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=pcb-ocr

# ── Authentication ────────────────────────────────────────────────
# Required on the Authorization: Bearer <API_KEY> header for every
# service's POST /extract (health/readiness endpoints stay open). Leave
# unset to disable auth entirely — useful for local dev, but every service
# reads this independently so set it before exposing any port publicly.
API_KEY=your-api-key-here

# ── OCR Settings ──────────────────────────────────────────────────
OCR_DPI=300

# ── vLLM Settings ─────────────────────────────────────────────────
GLM_OCR_VLLM_URL=http://vllm-glm-ocr:8010/v1
GLM_OCR_MODEL=zai-org/GLM-OCR
QWEN_VL_VLLM_URL=http://vllm-qwen-vl:8011/v1
QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ── Service Endpoints ─────────────────────────────────────────────
TESSERACT_URL=http://tesseract-ocr:8001/extract
GLM_OCR_URL=http://glm-ocr-api:8002/extract
QWEN_VL_URL=http://qwen-vl-api:8003/extract

# ── Async job registry (supervisor only) ───────────────────────────
# POST /extract returns a job_id immediately; the pipeline runs in the
# background and job state is persisted here so it survives a supervisor
# restart. JOB_TTL_SEC bounds how long a completed/failed job stays
# queryable via GET /jobs/{job_id} before Redis expires it.
REDIS_URL=redis://redis:6379/0
JOB_TTL_SEC=86400

# ── HuggingFace Token (for model downloads) ───────────────────────
# HF_TOKEN=your_token_here